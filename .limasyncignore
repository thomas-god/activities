# .limasyncignore
#
# Syntax is rsync's, not gitignore's:
#   - comments start with '#' or ';'
#   - a trailing '/' matches directories only
#   - no '/' matches the basename anywhere
#   - a pattern containing '/' is matched from the transfer root
#
# Copy or adapt this file in a project root. Remove entries that your
# project needs the agent to see.

